{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obeya",
  "mainBinaryName": "obeya",
  "version": "../package.json",
  "identifier": "si.obeya",
  "build": { "frontendDist": "ui" },
  "app": { "windows": [], "security": { "csp": null }, "macOSPrivateApi": true },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "publisher": "Daniel Sadilek",
    "copyright": "Copyright (c) 2026 Daniel Sadilek",
    "category": "DeveloperTool",
    "shortDescription": "A canvas for directing AI coding agents",
    "longDescription": "Obeya is a spatial canvas on which you direct AI coding agents like an engineering director directs a team.",
    "homepage": "https://obeya.si",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/obeya-server"],
    "resources": { "staged/resources/": "resources/" },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-", "entitlements": "entitlements.plist" },
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": {
      "deb": { "depends": ["git", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"] },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
